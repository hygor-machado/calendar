{
  "name": "calendar",
  "version": "1.0.0",
  "description": "Calendário em JavaScript puro (Web Component): datas e intervalos, visões de dia, mês e ano, e lista virtualizada com carga progressiva.",
  "private": true,
  "type": "module",
  "main": "public/src/virtual-calendar.js",
  "exports": {
    ".": "./public/src/virtual-calendar.js",
    "./date-utils": "./public/src/date-utils.js",
    "./selection": "./public/src/selection.js"
  },
  "files": [
    "public/src"
  ],
  "scripts": {
    "start": "node test/server.mjs 8080",
    "dev": "cf dev",
    "test": "node --test test/unit.test.mjs",
    "test:e2e": "node --test test/e2e.test.mjs",
    "deploy": "cf deploy"
  },
  "devDependencies": {
    "cf": "1.0.0-beta.28",
    "playwright": "1.56.1",
    "wrangler": "4.158.0"
  },
  "engines": {
    "node": ">=22.23"
  }
}
